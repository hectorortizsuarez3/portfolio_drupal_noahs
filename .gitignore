# Ignore configuration files that may contain sensitive information.
/web/sites/*/settings*.php
/web/sites/*/services*.yml
/web/sites/*/files
/web/sites/*/private
!/web/sites/development/settings*.php
!/web/sites/development/*services.yml

# Ignore directories generated by Composer.
/drush/Commands/contrib/
/web/core/*
/web/modules/contrib/*
/web/themes/contrib/*
/web/profiles/contrib/
/web/libraries/

# Ignore the root vendor directory.
/vendor/*
!/vendor/.gitignore

# Ignore scaffold files.
/web/.csslintrc
/web/.editorconfig
/web/.eslintignore
/web/.eslintrc.json
/web/.gitattributes
/web/.ht.router.php
/web/.htaccess
/web/INSTALL.txt
/web/README.txt
/web/autoload.php
/web/example.gitignore
/web/index.php
/web/robots.txt
/web/update.php
/web/web.config
/web/modules/README.txt
/web/profiles/README.txt
/web/sites/README.txt
/web/sites/default/default.services.yml
/web/sites/default/default.settings.php
/web/sites/development.services.yml
/web/sites/example.settings.local.php
/web/sites/example.sites.php
/web/sites/sites.php
/web/themes/README.txt

# Ignore files generated by PhpStorm
/.idea/

# Ignore files generated by VSCode
/.vscode/

# Ignore private and personal files.
/.env
/web/private
/private
/web/tmp
.sass-cache
.DS_Store
/.ddev
*.sql
/.composer
/.history
/.ssh

/tmp
*node_modules
private*
*.mysql.gz
web/core/modules/contrib/*
/web/sites/default/development.services.yml
/web/modules/.gitignore
/web/profiles/.gitignore
web/.gitignore
